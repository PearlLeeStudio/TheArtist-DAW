# TheArtist server environment template. Names only: never put a real value in
# this file or commit one. Keys live only on the server, never in the frontend bundle.

# Meta Model API (Standard mode). Read only from this variable.
MODEL_API_KEY=

# The Meta switch. 0/false/no/off rejects attempted Meta calls with HTTP 503
# "disabled". Auto import that needs no Meta work may still finish locally.
# The local reader, own chord model and exports keep working. Unset or 1 = on.
THEARTIST_META_ENABLED=1

# LLM provider switch for the planner / validator / explainer. All providers use
# the same OpenAI-compatible client; only base URL and model change.
#   meta      https://api.meta.ai/v1                 muse-spark-1.3
#   baseten   https://inference.baseten.co/v1        meta-models/muse-spark-open-1026
#   fireworks https://api.fireworks.ai/inference/v1  accounts/fireworks/models/muse-glimmer-30b
#   ollama    http://localhost:11434/v1              llama3.2:3b  (offline fallback, Meta open weights)
#   custom    Modal or any other OpenAI-compatible endpoint: set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY
LLM_PROVIDER=meta
# Leave empty to use the provider's endpoint and model from the table above
LLM_BASE_URL=
LLM_MODEL=
# Key for LLM_PROVIDER=custom (if set, it overrides the provider keys below); meta uses only MODEL_API_KEY
LLM_API_KEY=
# Per-attempt timeout in seconds. No transport retry; non-schema open-weight
# providers may retry malformed JSON once, within the calling operation's limits.
LLM_TIMEOUT_S=60
# minimal | low | medium | high, or none = not sent; empty = provider default (low; ollama, custom: not sent).
# baseten takes low | medium | high | xhigh (no minimal). The planner passes its own effort per call.
LLM_REASONING_EFFORT=
# USD per 1M tokens; empty = built-in Muse Spark 1.x Standard prices (1.25 / 0.15 / 4.25)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_CACHED_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# Spend cap in USD enforced in code, one per deployment (dev machine 25, judge
# server 40). The JSON ledger (absolute path on a persistent volume) records every
# request id, token count and settled cost; a warning is logged at 80 %, and the
# cap returns an explicit error, never a fallback that looks like success.
THEARTIST_META_BUDGET_USD=25
# Empty = backend/.ledger/meta_ledger.json; on a server use an absolute path on a persistent volume
THEARTIST_META_LEDGER=

# Open-weight providers (optional; only when credits arrive)
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# Judge role (the planner's observe-then-act decision and the second-ear review).
# Empty = the same provider and ledger as above. Set LLM_JUDGE_PROVIDER=baseten to
# run the judgment on Muse Spark Open with its own ledger and cap; the other
# LLM_JUDGE_* variables mirror the LLM_* ones (BASE_URL, MODEL, API_KEY, TIMEOUT_S,
# REASONING_EFFORT, PRICE_INPUT_PER_M, PRICE_CACHED_PER_M, PRICE_OUTPUT_PER_M).
LLM_JUDGE_PROVIDER=
LLM_JUDGE_REASONING_EFFORT=
THEARTIST_JUDGE_BUDGET_USD=10
THEARTIST_JUDGE_LEDGER=

# Local theory retrieval: prepare OMT with backend/scripts/setup_omt.py first.
# No embedding model, LLM or network call during retrieval. See docs/theory-retrieval.md.
THEARTIST_DISABLE_RAG=0
THEARTIST_RAG_OMT_ENABLED=1
THEARTIST_RAG_BERKLEE_ENABLED=0
# Berklee requires separate permission assessment and explicit private opt-in;
# it is rejected when THEARTIST_PUBLIC_HOST=1. Disabled sources are never read.
# THEARTIST_RAG_OMT_PATH=/absolute/path/to/reviewed.json
# THEARTIST_RAG_BERKLEE_PATH=/absolute/path/to/berklee.chunks.jsonl

# Startup preload. THEARTIST_WARMUP=1 loads every checkpoint; THEARTIST_WARMUP_KEYS (comma-separated keys such
# as ft_f1,ft_f4) loads only those and turns the preload on by itself; an explicit THEARTIST_WARMUP=0 still wins.
THEARTIST_WARMUP=
THEARTIST_WARMUP_KEYS=

# Judge-server lockdown. 1 answers 403 on /api/daw/* and POST /api/models/warmup, mounts no /mcp, refuses the
# whole-file Meta score read (engine meta; the bounded auto assist stays), and turns the Meta limits below on.
THEARTIST_PUBLIC_HOST=0
# The Meta limits without the lockdown (a semi-public host, or local testing).
THEARTIST_META_LIMITS=0
# Daily Meta allowance per browser session (X-TheArtist-Session header), the global daily cap over the ledger,
# and a separate allowance for requests whose X-TheArtist-Judge-Code equals THEARTIST_JUDGE_CODE. A Meta score
# reading reserves $1.35, more than the $1.00 session default: raise it or use the judge code for that path.
THEARTIST_META_SESSION_LIMIT_USD=1.00
THEARTIST_META_DAILY_LIMIT_USD=10.00
THEARTIST_JUDGE_CODE=
THEARTIST_JUDGE_CODE_DAILY_USD=5.00

# Comma-separated browser origins allowed by the backend
CORS_ORIGINS=
