# TheArtist server environment template. Names only: never put a real value in
# this file or commit one. Keys live only on the server, never in the frontend bundle.

# Meta Model API (Standard mode). Read only from this variable.
MODEL_API_KEY=

# LLM provider switch for the planner / validator / explainer. All providers use
# the same OpenAI-compatible client; only base URL and model change.
#   meta      https://api.meta.ai/v1                 muse-spark-1.3
#   baseten   https://inference.baseten.co/v1        meta-models/muse-spark-open-1026
#   modal     <shared endpoint URL from the Modal dashboard>
#   fireworks https://api.fireworks.ai/inference/v1  accounts/fireworks/models/muse-glimmer-30b
#   ollama    http://localhost:11434/v1              gemma3:4b  (offline fallback)
LLM_PROVIDER=meta
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3

# Spend cap in USD for the whole event, enforced in code; the JSON ledger records
# every request id, token count and settled cost.
THEARTIST_META_BUDGET_USD=25
THEARTIST_META_LEDGER=./meta_ledger.json

# Open-weight providers (optional; only when credits arrive)
BASETEN_API_KEY=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
FIREWORKS_API_KEY=

# Theory retrieval: the hackathon build indexes openly licensed corpora only
# (Open Music Theory v2 CC BY-SA 4.0, Wikipedia CC BY-SA 4.0). No Berklee text.
THEARTIST_DISABLE_RAG=0

# Where "Open in DAW" writes Standard MIDI Files (macOS only)
THEARTIST_EXPORT_DIR=~/Music/TheArtist Exports

# Comma-separated browser origins allowed by the backend
CORS_ORIGINS=
