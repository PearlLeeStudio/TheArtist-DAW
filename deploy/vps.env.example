# Copy to /srv/theartist.env on the server; keep it outside the Git checkout.
# Set a DNS name pointing at the server before starting HTTPS.
API_HOST=music-api.example.com
MODEL_API_KEY=
THEARTIST_META_ENABLED=0
# Explicitly allow the Meta only PDF/image reader on a public host.
# Its worst-case reservation (about $1.45; the limiter admits $1.50) needs room in both
# session and daily allowances.
THEARTIST_PUBLIC_META_READER=0
LLM_PROVIDER=meta
LLM_MODEL=muse-spark-1.3
THEARTIST_META_BUDGET_USD=10
# Meta stop line in USD (a little less than the credit the provider's console shows); Meta stops
# before passing it, also with THEARTIST_META_UNLIMITED=1. Empty = no line (compose.yaml's default since 2026-11-03).
THEARTIST_META_CREDIT_USD=
THEARTIST_JUDGE_BUDGET_USD=10
THEARTIST_META_SESSION_LIMIT_USD=2
THEARTIST_META_DAILY_LIMIT_USD=2
THEARTIST_DISABLE_RAG=0
THEARTIST_RAG_OMT_ENABLED=1
THEARTIST_RAG_BERKLEE_ENABLED=0
CORS_ORIGINS=
